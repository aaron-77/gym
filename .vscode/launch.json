{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Testing",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "Build:Test dependencies",
            "program": "${workspaceFolder}/GymWebApp.Tests/bin/Debug/net8.0/GymWebApp.Tests.dll", // Cambia esto según tu versión y nombre de proyecto
            "args": [],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
            },
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            },
            "sourceFileMap": {
                "/Views": "${workspaceFolder}/Views"
            }
        },
        {
            "name": "GymAPI",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "Build:API dependencies",
            "program": "${workspaceFolder}/API/bin/Debug/net8.0/API.dll", // Cambia esto según tu versión y nombre de proyecto
            "args": [],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
            },
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            },
            "sourceFileMap": {
                "/Views": "${workspaceFolder}/Views"
            }
        }
        ,
        {
            "name": "GymFront",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "Build:GymFrontend dependencies",
            "program": "${workspaceFolder}/GymFrontend/bin/Debug/net8.0/GymFrontend.dll", // Cambia esto según tu versión y nombre de proyecto
            "args": [],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
            },
            "launchBrowser": {
                "enabled": false
            },
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            },
            "sourceFileMap": {
                "/Views": "${workspaceFolder}/GymFrontend/Views"
            }
        }
    ]
}