# ---------- Etapa de build ----------
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /source

# Copiar los csproj y restaurar como capas separadas (aprovecha la caché)
COPY ["API/API.csproj", "API/"]
COPY ["BL/BL.csproj", "BL/"]
COPY ["DataAccess/DataAccess.csproj", "DataAccess/"]
COPY ["DTO/DTO.csproj", "DTO/"]
RUN dotnet restore "API/API.csproj"

# Copiar el resto del código
COPY API/ API/
COPY BL/ BL/
COPY DTO/ DTO/
COPY DataAccess/ DataAccess/

# Validar que los appsettings de los 3 entornos estén en el contexto de build
RUN test -f "API/appsettings.Development.json" \
    && test -f "API/appsettings.Staging.json" \
    && test -f "API/appsettings.Production.json" \
    && echo "Los 3 appsettings de entorno están presentes"

# Publicar
RUN dotnet publish "API/API.csproj" -c Release -o app --no-restore

# Mostrar los appsettings generados por publish antes de limpiar
RUN echo "=== appsettings presentes despues de publish (antes de limpiar) ===" \
    && ls -la app/appsettings*.json

# Conservar los appsettings de los 3 entornos (el base appsettings.json se conserva);
# se descarta cualquier otro (ej. appsettings.Testing.json)
RUN find app -maxdepth 1 -type f -name 'appsettings.*.json' \
      ! -name "appsettings.Development.json" \
      ! -name "appsettings.Staging.json" \
      ! -name "appsettings.Production.json" -delete \
    && echo "=== appsettings incluidos en la imagen ===" \
    && ls -la app/appsettings*.json

# ---------- Etapa final ----------
FROM mcr.microsoft.com/dotnet/aspnet:8.0
WORKDIR /app

COPY --from=build /source/app ./

RUN echo "=== appsettings en la imagen final ===" && ls -la /app/appsettings*.json

ENTRYPOINT ["dotnet", "API.dll"]
