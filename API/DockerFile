FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /source

# copy csproj and restore as distinct layers
COPY ["API/API.csproj", "API/"]
COPY ["BL/BL.csproj", "BL/"]
COPY ["DataAccess/DataAccess.csproj", "DataAccess/"]
COPY ["DTO/DTO.csproj", "DTO/"]
RUN dotnet restore "API/API.csproj"

# copy everything else and build app
COPY API/ /API
COPY BL/ BL/
COPY DTO/ DTO/
COPY DataAccess/ DataAccess/
RUN echo "=== Contenido de DIRECTORIO source EN API CONTAINER DESPUES DE PUBLISH/ ===" && ls -laR .
RUN dotnet publish API/API.csproj -c release -o app --no-restore
RUN echo "=== Contenido de DIRECTORIO APP EN API CONTAINER DESPUES DE PUBLISH/ ===" && ls -laR /app
# final stage/image
FROM mcr.microsoft.com/dotnet/aspnet:8.0
WORKDIR /app
COPY --from=build /source/app ./
RUN echo "=== Contenido de directorio app  en	API  ENTRYPOINT--------/ ===" && ls -laR .
ENTRYPOINT ["dotnet", "API.dll"]