# ---------- Etapa de build ----------
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /source

# Copiar los csproj y restaurar como capas separadas (aprovecha la caché)
COPY ["GymFrontend/GymFrontend.csproj", "GymFrontend/"]
COPY ["BL/BL.csproj", "BL/"]
COPY ["DataAccess/DataAccess.csproj", "DataAccess/"]
COPY ["DTO/DTO.csproj", "DTO/"]
RUN dotnet restore "GymFrontend/GymFrontend.csproj"

# Copiar el resto del código
COPY GymFrontend/ GymFrontend/
COPY BL/ BL/
COPY DTO/ DTO/
COPY DataAccess/ DataAccess/

# Validar el ambiente y que exista su appsettings
ARG BUILD_ENVIRONMENT
RUN echo "BUILD_ENVIRONMENT definido al inicio del build: ${BUILD_ENVIRONMENT}"
RUN case "$BUILD_ENVIRONMENT" in \
      Development|Staging|Production) ;; \
      *) echo "BUILD_ENVIRONMENT debe ser Development, Staging o Production" >&2; exit 1 ;; \
    esac \
    && test -f "GymFrontend/appsettings.${BUILD_ENVIRONMENT}.json"

# Publicar
RUN dotnet publish "GymFrontend/GymFrontend.csproj" -c Release -o app --no-restore

# Mostrar el entorno solicitado y los appsettings generados por publish antes de limpiar
RUN echo "BUILD_ENVIRONMENT=${BUILD_ENVIRONMENT}" \
    && echo "=== appsettings presentes despues de publish (antes de limpiar) ===" \
    && ls -la app/appsettings*.json

# Dejar solo el appsettings del ambiente elegido (el base appsettings.json se conserva)
RUN echo "BUILD_ENVIRONMENT antes de remover appsettings: ${BUILD_ENVIRONMENT}" \
    && test -f "app/appsettings.${BUILD_ENVIRONMENT}.json" \
    && find app -maxdepth 1 -type f -name 'appsettings.*.json' \
        ! -name "appsettings.${BUILD_ENVIRONMENT}.json" -delete \
    && echo "=== appsettings en app/ despues de la limpieza ===" \
    && ls -la app/appsettings*.json

# ---------- Etapa final ----------
FROM mcr.microsoft.com/dotnet/aspnet:8.0
WORKDIR /app

# El ARG se debe redeclarar en esta etapa para poder usarlo
ARG BUILD_ENVIRONMENT
ENV ASPNETCORE_ENVIRONMENT=${BUILD_ENVIRONMENT}

COPY --from=build /source/app ./

RUN echo "=== appsettings en la imagen final ===" && ls -la /app/appsettings*.json
RUN echo "ASPNETCORE_ENVIRONMENT antes del ENTRYPOINT: ${ASPNETCORE_ENVIRONMENT}"

ENTRYPOINT ["dotnet", "GymFrontend.dll"]
