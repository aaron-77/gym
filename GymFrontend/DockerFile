# https://hub.docker.com/_/microsoft-dotnet
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /source

# copy csproj and restore as distinct layers
COPY ./*.csproj ./GymFrontend/
RUN dotnet restore

# copy everything else and build app
COPY . ./GymFrontend/
WORKDIR /source/GymFrontend
RUN dotnet publish -c release -o /GymFrontendPublish --no-restore

# final stage/image
FROM mcr.microsoft.com/dotnet/aspnet:8.0
WORKDIR /GymFrontendApp
COPY --from=build /GymFrontendPublish ./
ENTRYPOINT ["dotnet", "GymFrontend.dll"]