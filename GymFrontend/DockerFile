# https://hub.docker.com/_/microsoft-dotnet
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /source

# copy csproj and restore as distinct layers
COPY GymFrontend/*.csproj ./
COPY BL/*.csproj ./
COPY DTO/*.csproj ./
COPY DataAccess/*.csproj ./
RUN dotnet restore "GymFrontend.csproj"

# copy everything else and build app
COPY GymFrontend/ ./
RUN dotnet publish GymFrontend.csproj -c release -o /app --no-restore

# final stage/image
FROM mcr.microsoft.com/dotnet/aspnet:8.0
WORKDIR /app
COPY --from=build /app ./
ENTRYPOINT ["dotnet", "GymFrontend.dll"]