# https://hub.docker.com/_/microsoft-dotnet
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /source

# copy csproj and restore as distinct layers
COPY ["GymFrontend/GymFrontend.csproj", "GymFrontend/"]
COPY ["BL/BL.csproj", "BL/"]
COPY ["DTO/DTO.csproj", "DTO/"]
COPY ["DataAccess/DataAccess.csproj", "DataAccess/"]
RUN dotnet restore "GymFrontend/GymFrontend.csproj"

# copy everything else and build app
COPY GymFrontend/ GymFrontend/
COPY BL/ BL/
COPY DTO/ DTO/
COPY DataAccess/ DataAccess/
RUN echo "=== Contenido de DIRECTORIO source EN PROYECTO GYMFRONTNED  DESPUS DE PUBLISH--------/ ===" && ls -laR .
RUN dotnet publish GymFrontend/GymFrontend.csproj -c release -o app --no-restore
RUN echo "=== Contenido de DIRECTORIO APP EN PROYECTO GYMFRONTNED  DESPUS DE PUBLISH--------/ ===" && ls -laR app

# final stage/image
FROM mcr.microsoft.com/dotnet/aspnet:8.0
WORKDIR /app
COPY --from=build /source/app ./
RUN echo "=== Contenido de GYMFRONTEND  APP DIRECTORY DESDE ENTRY POINT--------/ ===" && ls -laR .
ENTRYPOINT ["dotnet", "GymFrontend.dll"]
#ENTRYPOINT ["sh", "-c", "echo '=== Iniciando ===' && ls -la /app && echo '=== Ejecutando dotnet ===' && GymFrontend.dll || (echo 'ERROR:' && cat /dev/null)"]