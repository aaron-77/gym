@model DTO.Dtos.DuracionCitasMedicion;
@{
}
@using DTO.Dtos;

@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
Layout = "_LayoutSeccionAdministracion";

    var duracionExistente = ViewBag.duracion as DuracionCitasMedicion;
}

<head>
    <title>Ajustar duracion de citas- FitnessGym</title>
</head>
<div class="pagetitle">
    <h1>Gestion de duracion de citas de medicion</h1>

</div><!-- End Page Title -->

<section class="section medidas-section">

    <form id="formDuracionCitas" class="formulario needs-validation" action="duracionCitasMedicionPage" method="post" novalidate>

        <span id="validationSumary" class="validation-error">@ViewBag.message</span>

        <input id="inputIdDuracion" value="@Model.Id" type="hidden" name="Id"
            class="form-control empleados-main-page-input desactivable">

        <div>
            <label for="inputDuracion" class="form-label">Duracion de la cita en horas</label>
            <input id="inputDuracion" value="@Model.duracion" type="number" name="duracion"
                class="form-control empleados-main-page-input desactivable" required min="1">
            <div class="invalid-feedback">Campo obligatorio</div>
            <div class="valid-feedback"></div>
        </div>

        <div>
            <label for="inputFrecuencia" class="form-label">Frecuencia de notificaciones en dias</label>
            <input id="inputFrecuencia" value="@Model.frecuenciaNotificaciones" type="number"
                name="frecuenciaNotificaciones" class="form-control empleados-main-page-input desactivable" required min="1">
            <div class="invalid-feedback">Campo obligatorio</div>
            <div class="valid-feedback"></div>
        </div>

        @if (Model.Id > 0)
        {
            <button type="submit" class="btn btn-primary fix-margin">Guardar</button>

        }
        else
        {
            <button type="submit" class="btn btn-primary fix-margin">Registrar</button>

        }

    </form>
</section>
<a href="#" class="back-to-top d-flex align-items-center justify-content-center"><i
        class="bi bi-arrow-up-short"></i></a>

@section Scripts {
    <script src="~/js/registroCitas.js" type="module" asp-append-version="true"></script>
}
