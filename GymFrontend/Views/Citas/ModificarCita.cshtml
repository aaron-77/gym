@model DTO.Dtos.CitaEdit;
@{
}
@using DTO.Dtos;

@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
Layout = "_LayoutSeccionAdministracion.cshtml";

    var listadoClientes = ViewBag.clientes as List<QueryUser>;
    if (listadoClientes == null)
    {
        listadoClientes = new List<QueryUser>();
    }

    var listadoCitas = ViewBag.citas as List<Cita>;
    if (listadoClientes == null)
    {
        listadoCitas = new List<Cita>();
    }

}

<head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <title>Modificar Citas - FitnessGym</title>
</head>
<div class="pagetitle">
    <h1>Modificacion de citas</h1>

</div><!-- End Page Title -->

<section class="section medidas-section">
    <form id="formGestionRutinas" class="formulario" action="modificarCita" method="post">
        <span id="validationSumary" class="validation-error">@ViewBag.message</span>
        <label for="inputCliente" class="form-label">Cliente</label>
        <select id="inputCliente" class="form-select empleados-main-page-input" name=""
            aria-label="Default select example">
            <option value="">Seleccciona un cliente</option>
            @foreach (var cliente in listadoClientes)
            {
                <option value="@cliente.UsuarioID">@cliente.Nombre @cliente.Apellido</option>
            }
        </select>



        <label for="inputCita" class="form-label">Cita</label>
        <select id="inputCita" class="form-select empleados-main-page-input desactivable" name="Id"
            aria-label="Default select example">
            <option value="">Seleccciona una cita</option>

        </select>
        <span asp-validation-for="@Model.Id" class="validation-error"></span>

        <label for="inputFechaInicio" class="form-label">Fecha inicio</label>
        <input type="datetime-local" name="fechaInicioCita" class="form-control empleados-main-page-input desactivable"
            id="inputFechaInicio">
        <span asp-validation-for="@Model.fechaInicioCita" class="validation-error"></span>

        <label for="inputFechaFin" class="form-label">Fecha fin</label>
        <input type="datetime-local" name="fechaFinCita" class="form-control empleados-main-page-input desactivable"
            id="inputFechaFin">
        <span asp-validation-for="@Model.fechaFinCita" class="validation-error"></span>


        <label for="inputEntrenador" class="form-label">Entrenador</label>
        <select id="inputEntrenador" class="form-select empleados-main-page-input desactivable" name="fkEntrenador"
            aria-label="Default select example">
            <option value="">Seleccciona un entrenador</option>
        </select>
        <span asp-validation-for="@Model.fkEntrenador" class="validation-error"></span>

        <label for="inputEstado" class="form-label">Estado</label>
        <select id="inputEstado" class="form-select empleados-main-page-input desactivable" name="estado"
            aria-label="Default select example">


        </select>
        <span asp-validation-for="@Model.estado" class="validation-error"></span>


        <button type="submit" class="btn btn-primary fix-margin">Modificar</button>
    </form>
</section>
<a href="#" class="back-to-top d-flex align-items-center justify-content-center"><i
        class="bi bi-arrow-up-short"></i></a>
<script src="~/js/EdicionCitas.js" asp-append-version="true"></script>
