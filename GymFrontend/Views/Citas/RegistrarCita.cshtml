
@model DTO.Dtos.Cita;
@{
}
@using DTO.Dtos;

@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
Layout = "_LayoutSeccionAdministracion";

    var listadoClientes = ViewBag.clientes as List<QueryUser>;
    if (listadoClientes == null)
    {
        listadoClientes = new List<QueryUser>();
    }

}

<head>
    <title>Registrar Cita - FitnessGym</title>
</head>
<div class="pagetitle">
    <h1>Registro de citas</h1>

</div><!-- End Page Title -->

<section class="section medidas-section">
    <form id="formRegistrarCita" class="formulario needs-validation novalidate" action="registrarCita" method="post">
        <div>
            <label for="inputTipoCita" class="form-label">Tipo de cita</label>
            <select id="inputTipoCita" class="form-select empleados-main-page-input" name="tipoCita"
                aria-label="Default select example" required>
                <option value="">Seleccciona el tipo de cita</option>
                <option value="Medicion">Medicion</option>
            </select>
            <div class="invalid-feedback">Selecciona el tipo de cita</div>
            <div class="valid-feedback"></div>
        </div>

        <div>
            <label for="inputFechaInicio" class="form-label">Fecha inicio</label>
            <input type="datetime-local" step="3600" name="fechaInicioCita" class="form-control empleados-main-page-input desactivable"
                id="inputFechaInicio" required>
            <div class="invalid-feedback">Selecciona la fecha de inicio</div>
            <div class="valid-feedback"></div>
        </div>

        <div>
            <label for="inputFechaFin" class="form-label">Fecha fin</label>
            <input type="datetime-local" step="3600" name="fechaFinCita" class="form-control empleados-main-page-input desactivable"
                id="inputFechaFin" required>
            <div class="invalid-feedback">Selecciona la fecha de fin</div>
            <div class="valid-feedback"></div>
        </div>

        <div>
            <label for="inputCliente" class="form-label">Cliente</label>
            <select id="inputCliente" class="form-select empleados-main-page-input desactivable" name="fkCliente"
                aria-label="Default select example" required>
                <option value="">Seleccciona un cliente</option>
                @foreach (var cliente in listadoClientes)
                {
                    <option value="@cliente.UsuarioID">@cliente.Nombre @cliente.Apellido</option>
                }
            </select>
            <div class="invalid-feedback">Selecciona un cliente</div>
            <div class="valid-feedback"></div>
        </div>

        <div>
            <label for="inputEntrenador" class="form-label">Entrenador</label>
            <select id="inputEntrenador" class="form-select empleados-main-page-input desactivable" name="fkEntrenador"
                aria-label="Default select example" required>
                <option value="">Seleccciona un entrenador</option>
            </select>
            <div class="invalid-feedback">Selecciona un entrenador</div>
            <div class="valid-feedback"></div>
        </div>

        <button type="submit" class="btn btn-primary fix-margin">Agendar</button>
    </form>
</section>
<a href="#" class="back-to-top d-flex align-items-center justify-content-center"><i
        class="bi bi-arrow-up-short"></i></a>


@section Scripts {
    <script src="~/js/dateUtils.mjs" type="module" asp-append-version="true"></script>
    <script src="~/js/registroCitas.js" type="module" asp-append-version="true"></script>
}