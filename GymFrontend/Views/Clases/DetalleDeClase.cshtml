                        <img src="../img/svgmacuerna.svg" alt="Mancuernas" class="icon-large">
                    </div>
                    <h3 class="equipment-title">Mancuernas Ligeras</h3>
                    <p class="equipment-description">Para añadir resistencia a ejercicios como sentadillas o press de hombros.</p>
                </div>
                <div class="equipment-item">
                    <div class="equipment-icon">
                        <img src="../img/svgklettlebells.svg" alt="Kettlebells" class="icon-large">
                    </div>
                    <h3 class="equipment-title">Kettlebells</h3>
                    <p class="equipment-description">Ideales para ejercicios balísticos como swings o clean and press.</p>
                </div>
                <div class="equipment-item">
                    <div class="equipment-icon">
                        <img src="../img/esterilla.svg" alt="Esterilla" class="icon-large">
                    </div>
                    <h3 class="equipment-title">Esterilla</h3>
                    <p class="equipment-description">Para mayor comodidad en ejercicios de suelo como planchas o abdominales.</p>
                </div>
                <div class="equipment-item">
                    <div class="equipment-icon">
                        <img src="../img/aquabottle.svg" alt="Botella de Agua" class="icon-large">
                    </div>
                    <h3 class="equipment-title">Botella de Agua</h3>
                    <p class="equipment-description">Fundamental para mantenerte hidratado durante el entrenamiento intenso.</p>
                </div>
            </div>
        </div>
    </section>

