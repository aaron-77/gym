@{
    ViewData["Title"] = "Inscripción a Clases";
    Layout = "_LayoutSeccionAdministracion";
}

<div class="pagetitle">
    <h1>Inscripción a Clases</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item active">Inscripción a Clases</li>
        </ol>
    </nav>
</div>

<section class="section layout-inscripcion-clases">
    <form id="formInscripcionClase" class="administrative-form needs-validation" novalidate>
        <input type="hidden" name="idProgramacionClase" id="idProgramacionClase" />
        <div class="row mb-3">
            <div class="col-12">
                <div class="form-group">
                    <label for="comboClases" class="form-label">Clase</label>
                    <select id="comboClases" class="form-select" name="comboClases" required>
                        <option value="">Seleccione una clase...</option>
                    </select>
                    <div class="invalid-feedback">
                        Por favor selecciona una clase.
                    </div>
                </div>
            </div>
        </div>
        <div class="accordion" id="accordionAgendador">
            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button" type="button" data-bs-toggle="collapse"
                        data-bs-target="#collapseAgendadorodifica" aria-expanded="true" aria-controls="collapseAgendador">
                        Selecciona un horario
                    </button>
                </h2>
                <div id="collapseAgendador" class="accordion-collapse collapse show" data-bs-parent="#accordionAgendador">
                    <div class="accordion-body fix-padding-accordion-body">
                        @Html.Partial("_AgendadorDeHorarios",false)
                    </div>
                </div>
            </div>
        </div>
        <label id="labelTituloEspaciosDisponibles" class="mt-3 mb-3 form-label fix-font-weight fix-color--highlight" >Espacios disponibles</label>
        <label id="labelEspaciosDisponibles" class="mt-3 mb-3 form-label fix-font-weight fix-color--positiveContext" >0</label>
        <div class="row mb-3">
            <div class="col-12">
                <div class="form-group">
                    <label id="labelTituloEntrenador" class="form-label fix-font-weight fix-color--highlight">Entrenador: <span id="entrenadorNombre"></span></label>
                    <label id="labelEntrenador" class="form-label fix-font-weight fix-color--highlight">Selecciona una clase <span id="entrenadorNombre"></span></label>
                </div>
            </div>
        </div>
        <div class="mt-3">
            @{
                var vd = new Microsoft.AspNetCore.Mvc.ViewFeatures.ViewDataDictionary(ViewData) { ["idFormulario"] = "formInscripcionClase" };
            }
            @Html.Partial("_HorariosDelDia", false, vd)
        </div>
        <div class="row mb-3">
            <div class="col-12">
                <div class="form-group">
                    <label for="comboCliente" class="form-label">Cliente</label>
                    <select id="comboCliente" class="form-select" name="idCliente" required>
                        <option value="">Seleccione un cliente...</option>
                    </select>
                    <div class="invalid-feedback">
                        Por favor selecciona un cliente.
                    </div>
                </div>
            </div>
        </div>
        
        <div class="row">
            <div class="col-12 text-center">
                <button id="botonInscribir" type="submit" class="btn btn-primary">Inscribir</button>
            </div>
        </div>
    </form>
    <!-- Mostrar el visualizador de horarios después del formulario -->
    
</section>

@section Styles {
    <link rel="stylesheet" href="~/css/calendarioStyles.css" />
    <link rel="stylesheet" href="~/css/horariosDelDia.css" />
    <link rel="stylesheet" href="~/css/estilosInscripcionAClases.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
}

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
    <script type="module" src="~/js/messageManager.mjs"></script>
    <script type="module" src="~/js/httpClient.js"></script>
    <script type="module" src="~/js/calendarioInscripcion.js"></script>
    <script type="module" src="~/js/inscriptorDeClasesScheduler.js"></script>
    <script type="module" src="~/js/inscriptorDeClases.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
} 