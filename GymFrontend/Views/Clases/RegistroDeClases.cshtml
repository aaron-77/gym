@{
    ViewData["Title"] = "Registro de Clases";
    Layout = "_LayoutSeccionAdministracion";
}

<div class="pagetitle">
    <h1>Registro de Clases</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item active">Registro de Clases</li>
        </ol>
    </nav>
</div>

<section class="section">
    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Formulario de Registro</h5>

                    <form id="formRegistroClase" class="needs-validation" novalidate>
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label for="nombreClase" class="form-label">Nombre de la Clase</label>
                                <input type="text" class="form-control" id="nombreClase" name="nombreClase" required>
                                <div class="invalid-feedback">
                                    Por favor ingrese el nombre de la clase.
                                </div>
                            </div>
                            
                            <div class="col-md-6">
                                <label for="instructor" class="form-label">Instructor</label>
                                <select class="form-select" id="instructor" name="instructor" required>
                                    <option value="" selected disabled>Seleccione un instructor</option>
                                    @foreach (var instructor in ViewBag.Instructores)
                                    {
                                        <option value="@instructor.Id">@instructor.Nombre</option>
                                    }
                                </select>
                                <div class="invalid-feedback">
                                    Por favor seleccione un instructor.
                                </div>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-12">
                                <label for="descripcion" class="form-label">Descripción</label>
                                <textarea class="form-control" id="descripcion" name="descripcion" rows="3" required></textarea>
                                <div class="invalid-feedback">
                                    Por favor ingrese una descripción para la clase.
                                </div>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label for="duracionMinutos" class="form-label">Duración en minutos</label>
                                <input type="number" class="form-control" id="duracionMinutos" name="duracionMinutos" min="1" required>
                                <div class="invalid-feedback">
                                    Por favor ingrese la duración de la clase.
                                </div>
                            </div>
                            
                            <div class="col-md-6">
                                <label for="tiempoDescanso" class="form-label">Tiempo de descanso (minutos)</label>
                                <input type="number" class="form-control" id="tiempoDescanso" name="tiempoDescanso" min="0" required>
                                <div class="invalid-feedback">
                                    Por favor ingrese el tiempo de descanso.
                                </div>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label for="intensidad" class="form-label">Intensidad</label>
                                <select class="form-select" id="intensidad" name="intensidad" required>
                                    <option value="" selected disabled>Seleccione la intensidad</option>
                                    @foreach (var intensidad in ViewBag.Intensidades)
                                    {
                                        <option value="@intensidad.Id">@intensidad.Nombre</option>
                                    }
                                </select>
                                <div class="invalid-feedback">
                                    Por favor seleccione una intensidad.
                                </div>
                            </div>
                            
                            <div class="col-md-6">
                                <label for="dificultad" class="form-label">Dificultad</label>
                                <select class="form-select" id="dificultad" name="dificultad" required>
                                    <option value="" selected disabled>Seleccione la dificultad</option>
                                    @foreach (var dificultad in ViewBag.Dificultades)
                                    {
                                        <option value="@dificultad.Id">@dificultad.Nombre</option>
                                    }
                                </select>
                                <div class="invalid-feedback">
                                    Por favor seleccione una dificultad.
                                </div>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label for="duracionTotal" class="form-label">Duración total incluyendo descanso</label>
                                <input type="number" class="form-control" id="duracionTotal" name="duracionTotal" readonly>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-12 d-flex justify-content-end">
                                <button type="submit" class="btn btn-primary me-2">Guardar</button>
                                <button type="reset" class="btn btn-secondary">Limpiar</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        // Función para calcular la duración total
        function calcularDuracionTotal() {
            const duracionMinutos = parseInt(document.getElementById('duracionMinutos').value) || 0;
            const tiempoDescanso = parseInt(document.getElementById('tiempoDescanso').value) || 0;
            
            const duracionTotal = duracionMinutos + tiempoDescanso;
            document.getElementById('duracionTotal').value = duracionTotal;
        }

        // Agregar listeners para calcular la duración total cuando cambien los valores
        document.getElementById('duracionMinutos').addEventListener('change', calcularDuracionTotal);
        document.getElementById('tiempoDescanso').addEventListener('change', calcularDuracionTotal);

        // Validación del formulario usando Bootstrap
        (() => {
            'use strict';

            // Obtener todos los formularios a los que queremos aplicar estilos de validación de Bootstrap
            const forms = document.querySelectorAll('.needs-validation');

            // Recorremos los formularios y prevenimos el envío si no son válidos
            Array.from(forms).forEach(form => {
                form.addEventListener('submit', event => {
                    if (!form.checkValidity()) {
                        event.preventDefault();
                        event.stopPropagation();
                    }

                    form.classList.add('was-validated');
                }, false);
            });
        })();
    </script>
} 