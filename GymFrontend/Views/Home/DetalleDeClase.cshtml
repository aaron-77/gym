@model DTO.Dtos.DetalleDeClase

@{
    ViewData["Title"] = $"{Model.NombreClase} - FitnessGym";
    ViewData["Description"] = Model.DescripcionDeLaClase ?? "Descubre nuestras clases en FitnessGym.";
    ViewData["BodyClass"] = "clase-detalle-page";
    Layout = "_NavbarLayout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/stylesbaseDetallesDeClase.css">
    <link rel="stylesheet" href="~/css/detallesclase.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
}

<!-- Cabecera de la Clase -->
<section class="class-header" data-section="class-header" style="background-image: url('@Model.imagenesDeClase?.urlParaBanner');">
    <div class="class-header-overlay"></div>
    <div class="container">
        <div class="class-header-content">
            <h1 class="class-header-title" data-test="header-title">@Model.NombreClase</h1>
            <p class="class-header-subtitle" data-test="header-subtitle">@Model.SubtituloClase</p>
            <div class="class-header-info">
                <div class="info-badge" data-test="header-duration">
                    <img src="~/img/svgacceso24black.svg" alt="Duración" class="icon" data-test="header-duration-icon">
                    <span data-test="header-duration-text">@(Model.Duracion > 0 ? $"{Model.Duracion} minutos" : "45 minutos")</span>
                </div>
                <div class="info-badge" data-test="header-intensity">
                    <img src="~/img/flame.svg" alt="Intensidad" class="icon" data-test="header-intensity-icon">
                    <span data-test="header-intensity-text">@(!string.IsNullOrEmpty(Model.NivelDeIntensidad) ? Model.NivelDeIntensidad : "Alta Intensidad")</span>
                </div>
                <div class="info-badge" data-test="header-level">
                    <img src="~/img/target.svg" alt="Nivel" class="icon" data-test="header-level-icon">
                    <span data-test="header-level-text">@(!string.IsNullOrEmpty(Model.NivelDeDificultad) ? Model.NivelDeDificultad : "Intermedio a Avanzado")</span>
                </div>
            </div>
            <a asp-controller="Home" asp-action="Index" asp-fragment="membership" class="btn btn-primary btn-lg" data-test="header-cta">Reservar Clase</a>
        </div>
    </div>
</section>

<!-- Descripción General -->
<section class="class-description" data-section="class-description">
    <div class="container">
        <div class="description-grid">
            <div class="description-content">
                <h2 class="section-title" data-test="description-title">SOBRE ESTA <span class="text-accent">CLASE</span></h2>
                @if (!string.IsNullOrEmpty(Model.DescripcionDeLaClase))
                {
                    <p class="description-text" data-test="description-text">@Model.DescripcionDeLaClase</p>
                }
                else
                {
                    <p class="description-text" data-test="description-text">
                        El Entrenamiento por Intervalos de Alta Intensidad (HIIT) alterna entre ráfagas intensas de actividad y períodos fijos de actividad menos intensa o descanso. Nuestras clases HIIT están diseñadas para aumentar tu ritmo cardíaco y quemar más grasa en menos tiempo.
                    </p>
                    <p class="description-text" data-test="description-text">
                        Este tipo de entrenamiento te proporciona un entrenamiento completo mientras mejora tu condición cardiovascular y maximiza la quema de calorías. Los estudios han demostrado que el HIIT puede quemar hasta un 30% más de calorías que otras formas de cardio en el mismo período de tiempo.
                    </p>
                }
                <div class="description-features" data-test-container="benefits">
                    @if (Model.BeneficiosDeLaClase != null && Model.BeneficiosDeLaClase.Any())
                    {
                        @foreach (var beneficio in Model.BeneficiosDeLaClase)
                        {
                            @await Html.PartialAsync("~/Views/Shared/_BeneficioItem.cshtml", new { 
                                beneficio = beneficio.beneficio, 
                                descripcionBeneficio = beneficio.descripcionBeneficio, 
                                  urlPublica = beneficio.urlPublica 
                            })
                        }
                    }
                    else
                    {
                        @await Html.PartialAsync("~/Views/Shared/_BeneficioItem.cshtml", new { 
                            beneficio = "Mejora Cardiovascular", 
                            descripcionBeneficio = "Aumenta la capacidad aeróbica y anaeróbica", 
                            urlPublica = "~/img/heart.svg" 
                        })
                        @await Html.PartialAsync("~/Views/Shared/_BeneficioItem.cshtml", new { 
                            beneficio = "Quema de Grasa", 
                            descripcionBeneficio = "Mayor quema calórica durante y después del ejercicio", 
                            urlPublica = "~/img/flame.svg" 
                        })
                        @await Html.PartialAsync("~/Views/Shared/_BeneficioItem.cshtml", new { 
                            beneficio = "Eficiencia", 
                            descripcionBeneficio = "Resultados máximos en tiempo mínimo", 
                            urlPublica = "~/img/svgacceso24black.svg" 
                        })
                    }
                </div>
            </div>
            <div class="description-image">
                <img src="@(Model.imagenesDeClase?.urlParaParaDescripcionDeClase ?? "~/img/hiit2.webp")" alt="Clase en acción" data-test="description-image">
            </div>
        </div>
    </div>
</section>

<!-- Estructura de la Clase -->
<section class="class-structure" data-section="class-structure">
    <div class="container">
        <h2 class="section-title text-center" data-test="structure-title">ESTRUCTURA DE LA <span class="text-accent">CLASE</span></h2>
        <div class="structure-timeline" data-test-container="structure-items">
            @if (Model.EstructuraDeLaClase != null && Model.EstructuraDeLaClase.Any())
            {
                @foreach (var estructura in Model.EstructuraDeLaClase)
                {
                    @await Html.PartialAsync("~/Views/Shared/_EstructuraClaseItem.cshtml", estructura)
                }
            }
            else
            {
                @await Html.PartialAsync("~/Views/Shared/_EstructuraClaseItem.cshtml", new DTO.Dtos.DTOEstructuraDeClase
                {
                    TituloBloque = "Calentamiento",
                    DuracionMenorEnMinutos = 5,
                    DuracionMayorEnMinutos = 7,
                    DescripcionBloque = "Comenzamos con un calentamiento dinámico para preparar el cuerpo para el ejercicio intenso. Incluye movilidad articular, activación muscular y elevación gradual del ritmo cardíaco."
                })
                @await Html.PartialAsync("~/Views/Shared/_EstructuraClaseItem.cshtml", new DTO.Dtos.DTOEstructuraDeClase
                {
                    TituloBloque = "Bloques HIIT",
                    DuracionMenorEnMinutos = 30,
                    DuracionMayorEnMinutos = 30,
                    DescripcionBloque = "El núcleo de la clase consiste en 4-6 bloques de ejercicios de alta intensidad. Cada bloque alterna entre 20-40 segundos de trabajo máximo y 10-20 segundos de descanso. Realizamos 3-4 rondas de cada bloque con un minuto de recuperación entre bloques."
                })
                @await Html.PartialAsync("~/Views/Shared/_EstructuraClaseItem.cshtml", new DTO.Dtos.DTOEstructuraDeClase
                {
                    TituloBloque = "Enfriamiento",
                    DuracionMenorEnMinutos = 5,
                    DuracionMayorEnMinutos = 7,
                    DescripcionBloque = "Finalizamos con ejercicios de baja intensidad para reducir gradualmente el ritmo cardíaco, seguidos de estiramientos estáticos para mejorar la flexibilidad y acelerar la recuperación."
                })
            }
        </div>
    </div>
</section>

<!-- Ejercicios Principales -->
<section class="class-exercises" data-section="class-exercises">
    <div class="container">
        <h2 class="section-title text-center" data-test="exercises-title">EJERCICIOS <span class="text-accent">PRINCIPALES</span></h2>
        <p class="section-subtitle text-center" data-test="exercises-subtitle">
            Estos son algunos de los ejercicios que podrás encontrar en nuestras clases de HIIT. Cada sesión varía para mantener el entrenamiento desafiante y evitar estancamientos.
        </p>
        
        <div class="exercises-grid" data-test-container="exercises">
            @if (Model.EjerciciosDeClase != null && Model.EjerciciosDeClase.Any())
            {
                @foreach (var ejercicio in Model.EjerciciosDeClase)
                {
                    @await Html.PartialAsync("~/Views/Shared/_EjercicioCard.cshtml", ejercicio)
                }
            }
            else
            {
                <p class="text-center" data-test="exercises-empty">No hay ejercicios disponibles para esta clase.</p>
            }
        </div>
    </div>
</section>

<!-- Consejos para Principiantes -->
<section class="class-tips" data-section="class-tips">
    <div class="container">
        <div class="tips-content">
            <h2 class="section-title" data-test="tips-title">CONSEJOS PARA <span class="text-accent">PRINCIPIANTES</span></h2>
            @if (Model.Consejos != null)
            {
                @await Html.PartialAsync("~/Views/Shared/_ConsejoIntro.cshtml", Model.Consejos)
                @await Html.PartialAsync("~/Views/Shared/_ConsejosList.cshtml", Model.Consejos)
            }
        </div>
        <div class="tips-image">
            <img src="@(Model.imagenesDeClase?.urlParaBloqueConsejos ?? "~/img/lesiongym.webp")" alt="Consejos para principiantes" data-test="tips-image">
        </div>
    </div>
</section>

<!-- Equipamiento -->
<section class="class-equipment" data-section="class-equipment">
    <div class="container">
        <h2 class="section-title text-center" data-test="equipment-title">EQUIPAMIENTO <span class="text-accent">RECOMENDADO</span></h2>
        <p class="section-subtitle text-center" data-test="equipment-subtitle">
            Estos elementos pueden mejorar tu experiencia:
        </p>
        
        <div class="equipment-grid" data-test-container="equipment">
            @if (Model.EquipamientoRecomendado != null && Model.EquipamientoRecomendado.Any())
            {
                @foreach (var equipo in Model.EquipamientoRecomendado)
                {
                     
                    @await Html.PartialAsync("~/Views/Shared/_EquipoItem.cshtml", equipo)
                }
            }
            else
            {
                <p class="text-center" data-test="equipment-empty">No hay equipamiento recomendado para esta clase.</p>
            }
        </div>
    </div>
</section>

<!-- Horarios -->
<section class="class-schedule" data-section="class-schedule">
    <div class="container">
        <h2 class="section-title text-center" data-test="schedule-title">HORARIOS <span class="text-accent">DISPONIBLES</span></h2>
        <p class="section-subtitle text-center" data-test="schedule-subtitle">
            Ofrecemos múltiples horarios para adaptarnos a tu agenda. ¡Reserva tu plaza ahora!
        </p>
        
        @if (Model.HorariosProgramados != null && Model.HorariosProgramados.Any())
        {
            @await Html.PartialAsync("~/Views/Shared/_HorarioClases.cshtml", Model.HorariosProgramados)
        }
        else
        {
            @await Html.PartialAsync("~/Views/Shared/_HorarioClases.cshtml", new List<DTO.Dtos.ClaseProgramada>
            {
                new DTO.Dtos.ClaseProgramada
                {
                    DiaDeLaSemana = "Lunes",
                    HoraInicio = "6:00",
                    HoraFin = "6:45",
                    NombreEntrenador = "Sara Jiménez"
                },
                new DTO.Dtos.ClaseProgramada
                {
                    DiaDeLaSemana = "Martes",
                    HoraInicio = "17:30",
                    HoraFin = "18:15",
                    NombreEntrenador = "Miguel Martínez"
                },
                new DTO.Dtos.ClaseProgramada
                {
                    DiaDeLaSemana = "Jueves",
                    HoraInicio = "6:00",
                    HoraFin = "6:45",
                    NombreEntrenador = "Sara Jiménez"
                }
            })
        }
    </div>
</section>

<!-- CTA -->
<section class="class-cta" data-section="class-cta">
    <div class="cta-overlay"></div>
    <div class="container">
        <div class="cta-content">
            <h2 class="cta-title" data-test="cta-title">¿LISTO PARA LLEVAR TU FITNESS AL <span class="text-accent">SIGUIENTE NIVEL</span>?</h2>
            <p class="cta-text" data-test="cta-text">
                Únete a nuestras clases de HIIT y experimenta una transformación física y mental. El primer paso hacia un nuevo tú comienza aquí.
            </p>
            <div class="cta-buttons">
                <a asp-controller="Home" asp-action="Index" asp-fragment="membership" class="btn btn-primary btn-lg" data-test="cta-primary-btn">Reservar Clase</a>
                <button class="btn btn-outline btn-lg" data-test="cta-secondary-btn">Ver Todas las Clases</button>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script type="module" src="~/js/detalles-clase.js"></script>
}