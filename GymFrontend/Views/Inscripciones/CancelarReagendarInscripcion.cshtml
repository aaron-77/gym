@model List<DTO.Dtos.QueryUser>
@{
    ViewData["Title"] = "Cancelar / Reagendar Inscripción";
    Layout = "_LayoutSeccionAdministracion";
}

<div class="pagetitle">
    <h1>Cancelar / Reagendar Inscripción</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item active">Cancelar / Reagendar Inscripción</li>
        </ol>
    </nav>
</div>

<section class="section">
    @if (!string.IsNullOrEmpty(ViewBag.ErrorMessage))
    {
        <div class="alert alert-danger" role="alert">
            @ViewBag.ErrorMessage
        </div>
    }

    <div class="card">
        <div class="card-header">
            <h5 class="card-title mb-0">Seleccionar Cliente</h5>
        </div>
        <div class="card-body">
            @if (Model != null && Model.Count > 0)
            {
                <div class="table-responsive mt-3">
                    <table class="table table-hover align-middle" id="tablaClientes">
                        <thead class="table-light">
                            <tr>
                                <th>Nombre</th>
                                <th>Apellido</th>
                                <th>Email</th>
                                <th>Teléfono</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var cliente in Model)
                            {
                                <tr>
                                    <td>@cliente.Nombre</td>
                                    <td>@cliente.Apellido</td>
                                    <td>@cliente.Email</td>
                                    <td>@cliente.Telefono</td>
                                    <td>
                                        <button type="button"
                                                class="btn btn-primary btn-sm seleccionar-cliente"
                                                data-cliente-id="@cliente.UsuarioID"
                                                data-cliente-nombre="@cliente.Nombre @cliente.Apellido">
                                            Seleccionar
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info mt-3" role="alert">
                    No se encontraron clientes activos.
                </div>
            }
        </div>
    </div>

    <div id="detalleCliente" class="card d-none">
        <div class="card-header">
            <h5 class="card-title mb-0">Inscripciones de <span id="nombreClienteSeleccionado"></span></h5>
        </div>
        <div class="card-body">
            <div class="alert alert-info">
                Seleccioná un cliente de la tabla superior para ver sus inscripciones y poder cancelar o reagendar.
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        document.querySelectorAll('.seleccionar-cliente').forEach(function(boton) {
            boton.addEventListener('click', function() {
                var clienteId = this.getAttribute('data-cliente-id');
                var nombreCompleto = this.getAttribute('data-cliente-nombre');
                document.getElementById('nombreClienteSeleccionado').textContent = nombreCompleto;
                var detalle = document.getElementById('detalleCliente');
                detalle.classList.remove('d-none');
            });
        });
    </script>
}
