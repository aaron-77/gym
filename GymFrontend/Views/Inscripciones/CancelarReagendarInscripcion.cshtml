@model List<DTO.Dtos.QueryUser>
@{
    ViewData["Title"] = "Cancelar / Reagendar Inscripción";
    Layout = "_LayoutSeccionAdministracion";
}

@section Styles {
    <link rel="stylesheet" href="~/css/calendarioStyles.css" />
    <link rel="stylesheet" href="~/css/horariosDelDia.css" />
    <link rel="stylesheet" href="~/css/registroClasesProgramadas.css" />
    <link rel="stylesheet" href="~/css/cancelarReagendarInscripcion.css" />
}

<div class="pagetitle">
    <h1>Cancelar / Reagendar Inscripción</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Inicio</a></li>
            <li class="breadcrumb-item active">Cancelar / Reagendar Inscripción</li>
        </ol>
    </nav>
</div>

<section class="section layout-registro-clases-programadas">
    @if (!string.IsNullOrEmpty(ViewBag.ErrorMessage))
    {
        <div class="alert alert-danger" role="alert">
            @ViewBag.ErrorMessage
        </div>
    }

    <form id="cancelarReagendarForm" class="administrative-form needs-validation" novalidate>
        @Html.AntiForgeryToken()
        <div class="row">
            <div class="col-12">
                <div class="form-group">
                    <label for="comboCliente" class="form-label">Cliente</label>
                    <select id="comboCliente" class="form-select" required>
                        <option value="">Seleccione un cliente...</option>
                        @if (Model != null)
                        {
                            @foreach (var cliente in Model)
                            {
                                <option value="@cliente.UsuarioID">@cliente.Nombre @cliente.Apellido - @cliente.Email</option>
                            }
                        }
                    </select>
                    <div class="invalid-feedback">
                        Por favor seleccione un cliente.
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-12">
                <div class="form-group">
                    <label for="comboInscripcion" class="form-label">Inscripción</label>
                    <select id="comboInscripcion" class="form-select" disabled required>
                        <option value="">Primero seleccione un cliente...</option>
                    </select>
                    <div class="invalid-feedback">
                        Por favor seleccione una inscripción.
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-12">
                <div class="form-check mb-3">
                    <input type="checkbox" id="checkReagendar" class="form-check-input" />
                    <label class="form-check-label" for="checkReagendar">Reagendar</label>
                </div>
            </div>
        </div>
    </form>

    <div id="contenedorCalendario" class="d-none">
        <partial name="_Calendario" />
    </div>

    <div id="contenedorScheduler" class="d-none">
        <partial name="_HorariosDelDia" model="false" />
    </div>

    <div class="row mt-4">
        <div class="col-12 text-center">
            <button type="button" id="btnEjecutar" class="btn btn-primary">Cancelar</button>
            <button type="button" id="btnLimpiar" class="btn btn-secondary">Limpiar</button>
        </div>
    </div>
</section>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script type="module" src="~/js/messageManager.mjs"></script>
    <script type="module" src="~/js/httpClient.js"></script>
    <script type="module" src="~/js/calendario.js"></script>
    <script type="module" src="~/js/horariosDelDia.js"></script>
    <script type="module" src="~/js/agendarioDeHorarios.js"></script>
    <script type="module" src="~/js/cancelarReagendarInscripcion.js"></script>
}
