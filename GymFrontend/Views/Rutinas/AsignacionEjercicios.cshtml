@model DTO.Dtos.AsignacionDeEjercicio;
@{
}
@using DTO.Dtos;

@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
Layout = "_LayoutSeccionAdministracion";

    var listadoClientes = ViewBag.clientes as List<QueryUser>;
    if (listadoClientes == null)
    {
        listadoClientes = new List<QueryUser>();
    }

    var listadoRutinas = ViewBag.rutinas as List<Rutina>;
    if (listadoRutinas == null)
    {
        listadoRutinas = new List<Rutina>();
    }
    var listadoEjercicios = ViewBag.ejercicios as List<Ejercicio>;
    if (listadoEjercicios == null)
    {
        listadoEjercicios = new List<Ejercicio>();
    }
}

<head>
    <title>Asignacion de ejercicios - FitnessGym</title>
</head>

<div class="pagetitle">
    <h1>Asignacion de ejercicios</h1>

</div><!-- End Page Title -->

<section class="section medidas-section">
    <form id="formGestionRutinas" class="formulario needs-validation novalidate" action="asignarEjercicios" method="post">
        <div>
            <label for="inputCliente" class="form-label">Cliente</label>
            <select id="inputCliente" class="form-select empleados-main-page-input" name="UsuarioID"
                aria-label="Default select example" required>
                <option value="">Seleccciona un cliente</option>
                @foreach (var cliente in listadoClientes)
                {
                    <option value="@cliente.UsuarioID">@cliente.Nombre @cliente.Apellido</option>
                }
            </select>
            <div class="invalid-feedback">Selecciona un cliente</div>
            <div class="valid-feedback"></div>
        </div>

        <div>
            <label for="inputRutina" class="form-label">Rutina</label>
            <select id="inputRutina" class="form-select empleados-main-page-input desactivable" name="RutinaID"
                aria-label="Default select example" required>
                <option value="">Seleccciona una rutina</option>
            </select>
            <div class="invalid-feedback">Selecciona una rutina</div>
            <div class="valid-feedback"></div>
        </div>

        <div>
            <label for="inputEjercicio" class="form-label">Ejercicio</label>
            <select id="inputEjercicio" class="form-select empleados-main-page-input desactivable" name="EjercicioID"
                aria-label="Default select example" required>
                <option value="">Seleccciona un ejercicio</option>
            </select>
            <div class="invalid-feedback">Selecciona un ejercicio</div>
            <div class="valid-feedback"></div>
        </div>

        <div>
            <label for="inputSets" class="form-label">Sets</label>
            <input type="number" name="Sets" class="form-control empleados-main-page-input desactivable-g" id="inputSets" required min="1">
            <div class="invalid-feedback">Ingresa el número de sets</div>
            <div class="valid-feedback"></div>
        </div>

        <div>
            <label for="inputRepeticiones" class="form-label">Repeticiones</label>
            <input type="number" name="Repeticiones" class="form-control empleados-main-page-input desactivable-g"
                id="inputRepeticiones">
            <div class="invalid-feedback"></div>
            <div class="valid-feedback"></div>
        </div>

        <div>
            <label for="inputPeso" class="form-label">Peso</label>
            <input type="number" name="Peso" value="0" class="form-control empleados-main-page-input desactivable-g"
                id="inputPeso">
            <div class="invalid-feedback"></div>
            <div class="valid-feedback"></div>
        </div>

        <div>
            <label for="inputTiempo" class="form-label">Tiempo</label>
            <input type="number" name="Tiempo" value="0" class="form-control empleados-main-page-input desactivable-g"
                id="inputTiempo">
            <div class="invalid-feedback"></div>
            <div class="valid-feedback"></div>
        </div>

        <div>
            <label for="inputMetarepeticiones" class="form-label">Metarepeticiones</label>
            <input type="number" name="MetaRepeticiones" value="0" class="form-control empleados-main-page-input"
                id="inputMetarepeticiones">
            <div class="invalid-feedback"></div>
            <div class="valid-feedback"></div>
        </div>

        <button type="submit" class="btn btn-primary fix-margin">Asignar</button>
    </form>
</section>

<a href="#" class="back-to-top d-flex align-items-center justify-content-center"><i
        class="bi bi-arrow-up-short"></i></a>
@section Scripts {
    <script src="~/js/gestionRutinas.js" type="module" asp-append-version="true"></script>
}
