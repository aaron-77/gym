@{
    var currentYear = DateTime.Now.Year;
    var currentMonth = DateTime.Now.Month;
}



    
    <div class="calendar-container" id="calendar">
        <div class="calendar-header">
            <button type="button" class="nav-button nav-button--prev" id="prevButton" aria-label="Anterior">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="15,18 9,12 15,6"></polyline>
                </svg>
            </button>
            
            <div class="calendar-title">
                <button class="title-button" id="monthButton" data-type="month"></button>
                <button class="title-button" id="yearButton" data-type="year"></button>
            </div>
            
            <button  type="button" class="nav-button nav-button--next" id="nextButton" aria-label="Siguiente">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="9,18 15,12 9,6"></polyline>
                </svg>
            </button>
        </div>
        
        <div class="calendar-content" id="calendarContent">
            <div class="calendar-grid" id="calendarGrid">
                <!-- Contenido dinámico generado por JavaScript -->
            </div>
            <input id="fechaDeLaClase" class="form-control visually-hidden" type="date" name="fechaDeLaClase" required/>
            <div class="invalid-feedback text-center">
                selecciona una fecha
            </div>

        </div>
    </div>
