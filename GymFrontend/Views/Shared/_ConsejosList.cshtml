@model DTO.Dtos.DTOConsejoDeClase

<ul class="tips-list" data-test-container="tips">
    @if (Model.consejos != null)
    {
        @foreach (var consejo in Model.consejos)
        {
        <li class="tips-item" data-test="tip-item">
            <div class="tips-icon">
                <svg  class="icon" data-test="tip-icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
            </div>
            <span data-test="tip-text">@consejo</span>
        </li>
        }
    }
</ul>
