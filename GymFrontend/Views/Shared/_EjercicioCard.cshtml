@model DTO.Dtos.EjercicioPreview

<div class="exercise-card">
    <div class="exercise-image">
        <img src="@Model.UrlImagen" alt="@Model.NombreEjercicio">
    </div>
    <div class="exercise-content">
        <h3 class="exercise-title">@Model.NombreEjercicio</h3>
        <p class="exercise-description">@Model.DescripcionEjercicio</p>
    </div>
</div>
