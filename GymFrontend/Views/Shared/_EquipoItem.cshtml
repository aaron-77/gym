@model DTO.Dtos.DTOEquipo

<div class="equipment-item" data-test="equipment-item">
    <div class="equipment-icon">
        <img src="@Model.UrlIcono" alt="@Model.NombreEquipo" class="icon-large" data-test="equipment-icon">
    </div>
    <h3 class="equipment-title" data-test="equipment-title">@Model.NombreEquipo</h3>
    <p class="equipment-description" data-test="equipment-desc">@Model.Descripcion</p>
</div>
