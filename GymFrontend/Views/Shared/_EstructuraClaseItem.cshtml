@model DTO.Dtos.DTOEstructuraDeClase

<div class="timeline-item">
    <div class="timeline-marker"></div>
    <div class="timeline-content">
        <h3 class="timeline-title">@Model.TituloBloque (@Model.DuracionMenorEnMinutos-@Model.DuracionMayorEnMinutos min)</h3>
        <p class="timeline-text">
            @Model.DescripcionBloque
        </p>
    </div>
</div>
