@model List<DTO.Dtos.ClaseProgramada>

<div class="schedule-table" data-test-container="schedules">
    <div class="schedule-header schedule-row" data-test="schedule-header-row">
        <div class="schedule-cell" data-test="schedule-header-day">Día</div>
        <div class="schedule-cell" data-test="schedule-header-time">Horario</div>
        <div class="schedule-cell" data-test="schedule-header-instructor">Instructor</div>
    </div>
    @foreach (var horario in Model)
    {
        <div class="schedule-row" data-test="schedule-item">
            <div class="schedule-cell" data-test="schedule-day">@horario.DiaDeLaSemana</div>
            <div class="schedule-cell" data-test="schedule-time">@horario.HoraInicio - @horario.HoraFin</div>
            <div class="schedule-cell" data-test="schedule-instructor">@horario.NombreEntrenador</div>
        </div>
    }
</div>
