<div class="schedule-viewer" id="scheduleViewer">
    <div class="schedule-viewer__controls">
        <div class="form-check">
            <input type="checkbox" id="ocultarPreReservados" class="form-check-input" name="ocultarPreReservados" formnovalidate>
            <label for="ocultarPreReservados" class="form-check-label">Ocultar pre reservados</label>
        </div>
    </div>
    <div class="schedule-viewer__header">
        <h3 class="schedule-viewer__title" id="scheduleDate">
            Selecciona una fecha
        </h3>
    </div>
    
    <div class="schedule-viewer__content">
        <div class="schedule-viewer__grid" id="scheduleGrid">
            <!-- Los horarios se generarán dinámicamente -->
        </div>
    </div>
    
    <input type="hidden" id="fkHoraLaboral" name="fkHoraLaboral" value="" />
</div>

 