<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <title>Medidas - FitnessGym</title>
    <meta content="" name="description">
    <meta content="" name="keywords">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/global.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/GymFrontend.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <!-- Favicons -->
    <link href="assets/img/favicon.png" rel="icon">
    <!-- Google Fonts -->
    <link href="https://fonts.gstatic.com" rel="preconnect">
    <link
        href="https://fonts.googleapis.com/css?family=Open+Sans:300,300i,400,400i,600,600i,700,700i|Nunito:300,300i,400,400i,600,600i,700,700i|Poppins:300,300i,400,400i,500,500i,600,600i,700,700i"
        rel="stylesheet">
    <!-- Vendor CSS Files -->
    <link href="~/lib/bootstrap-icons2/bootstrap-icons.css" rel="stylesheet">
    <!-- Template Main CSS File -->
    <link href="~/css/styleNavBar.css" rel="stylesheet">

</head>

<body>

    <header id="header" class="header fixed-top d-flex align-items-center">
        <div class="d-flex align-items-center justify-content-between">
            <a href="index.html" class="logo d-flex align-items-center">
                <img src="assets/img/logo.png" alt="">
                <span class="d-none d-lg-block">Fitness Gym</span>
            </a>
            <i class="bi bi-list toggle-sidebar-btn"></i>
        </div><!-- End Logo -->
        <nav class="header-nav ms-auto">
            <ul class="d-flex align-items-center">
                <li class="nav-item d-block d-lg-none">
                    <a class="nav-link nav-icon search-bar-toggle " href="#">
                        <i class="bi bi-search"></i>
                    </a>
                </li><!-- End Search Icon-->
            </ul>
        </nav><!-- End Icons Navigation -->
    </header><!-- End Header -->
    <!-- ======= Sidebar ======= -->
    <aside id="sidebar" class="sidebar">
        <ul class="sidebar-nav" id="sidebar-nav">
            <li class="nav-heading">Pages</li>
            <li class="nav-item">
                <a class="nav-link collapsed" href="/empleados">
                    <span>Medidas</span>
                </a>
            <li class="nav-item">
                <a class="nav-link collapsed" href="/gestionRutinas">
                    <span>Registrar rutina</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link collapsed" href="/asignarEjercicios">
                    <span>Asignar Ejercicios</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link collapsed" href="/registrarCita?page=asignar">
                    <span>Registrar Cita</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link collapsed" href="/modificarCita">
                    <span>Modificar Cita</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link collapsed" href="/duracionCitasMedicionPage">
                    <span>Duracion citas medicion</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link collapsed" href="/Clases/registroClasesProgramadas">
                    <span>Registro de Clases Programadas</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link collapsed" href="/Clases/inscripcionAClases">
                    <span>Inscripción a Clases</span>
                </a>
            </li>
            <li class="nav-item"></li>
                
                <a id="logoutLink" class="nav-link collapsed" href="#">
                    <span>Crerrar Sesión</span>
                </a>
            </li>
            <!-- End Profile Page Nav -->
        </ul>
    </aside>
    <!-- End Sidebar-->

    <main id="main" class="main">
        @using (Html.BeginForm("CerrarSesion", "Users", FormMethod.Post, new { id = "logoutForm" }))
        {
            <button type="submit" style="display:none;"></button>
        }
        @RenderBody()
    </main>
    <script src="~/js/main.js"></script>
    <script src="~/lib/bootstrap2/bootstrap.bundle.min.js"></script>
    <script src="assets/vendor/quill/quill.js"></script>
    <script src="~/js/Logout.js"></script>
</body>
@RenderSection("Scripts", required: false)
@RenderSection("Styles", required: false)
</html>
