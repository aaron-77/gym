<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <meta name="description" content="@ViewData["Description"]">
    
    <link rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&amp;display=swap">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />
    <link rel="stylesheet" href="~/css/custom-navbar.css" type="text/css">
    <link rel="stylesheet" href="~/css/estilosFooter.css" type="text/css">
    @RenderSection("Styles", required: false)
</head>

<body class="@ViewData["BodyClass"]">
    <!-- Navegación -->
    <nav class="navbar">
        <div class="container">

            <div class="nav-links" id="navLinks">
                <div class="logo">
                    <img src="~/img/svgprincipallogo.svg" alt="Logo GymPower">
                    <span class="logo-text">GYM<span class="text-accent">POWER</span></span>
                </div>
                <a asp-area="" asp-controller="Home" asp-action="Index" asp-fragment="home" class="nav-link">Inicio</a>
                <a asp-area="" asp-controller="Home" asp-action="Index" asp-fragment="about" class="nav-link">Acerca
                    de</a>
                <a asp-area="" asp-controller="Home" asp-action="Index" asp-fragment="clases"
                    class="nav-link">Clases</a>
                <a asp-area="" asp-controller="Home" asp-action="Index" asp-fragment="trainers"
                    class="nav-link">Entrenadores</a>
                <a asp-area="" asp-controller="Home" asp-action="Index" asp-fragment="testimonials"
                    class="nav-link">Testimonios</a>
                <a asp-area="" asp-controller="Home" asp-action="Index" asp-fragment="membership"
                    class="nav-link">Membresías</a>
                <a asp-area="" asp-controller="Users" asp-action="Index" class="nav-link">Iniciar Sesión</a>
                <a asp-area="" asp-controller="Users" asp-action="CrearCuenta" class="nav-link">Registrarse</a>
                <a asp-area="" asp-controller="Home" asp-action="Index" asp-fragment="membership"
                    class="btn btn-primary fix-margin-button-uneteAhora" id="botonUneteAhora">Únete Ahora</a>
            </div>

            <button class="mobile-menu-btn" id="mobileMenuBtn">
                <span></span>
                <span></span>
                <span></span>
            </button>
        </div>
    </nav>

    @RenderBody()

    <!-- Pie de página -->
    <footer class="footer">
        <div class="container">
            <div class="footer-grid">
                <div class="footer-col">
                    <div class="logo">
                        <img src="~/img/svgprincipallogo.svg" alt="Logo GymPower">
                        <span class="logo-text">GYM<span class="text-accent">POWER</span></span>
                    </div>
                    <p class="footer-text">
                        Libera tu potencial y transforma tu cuerpo con nuestros entrenadores expertos y nuestras
                        instalaciones de última generación.
                    </p>
                </div>
                <div class="footer-col">
                    <h3 class="footer-title">Enlaces Rápidos</h3>
                    <ul class="footer-links">
                        <li><a class="footer-link" asp-area="" asp-controller="Home" asp-action="Index" asp-fragment="home">Inicio</a></li>
                        <li><a class="footer-link" asp-area="" asp-controller="Home" asp-action="Index" asp-fragment="about">Acerca de</a>
                        </li>
                        <li><a class="footer-link" asp-area="" asp-controller="Home" asp-action="Index" asp-fragment="clases">Clases</a>
                        </li>
                        <li><a class="footer-link" asp-area="" asp-controller="Home" asp-action="Index"
                                asp-fragment="trainers">Entrenadores</a></li>
                        <li><a class="footer-link" asp-area="" asp-controller="Home" asp-action="Index"
                                asp-fragment="testimonials">Testimonios</a></li>
                        <li><a class="footer-link" asp-area="" asp-controller="Users" asp-action="Index">Iniciar Sesión</a></li>
                        <li><a class="footer-link" asp-area="" asp-controller="Users" asp-action="CrearCuenta">Registrarse</a></li>
                    </ul>
                </div>
                <div class="footer-col">
                    <h3 class="footer-title">Horarios</h3>
                    <ul class="footer-info">
                        <li class="footer-link">Lunes - Viernes: 5am - 11pm</li>
                        <li class="footer-link">Sábado: 7am - 9pm</li>
                        <li class="footer-link">Domingo: 8am - 8pm</li>
                    </ul>
                </div>
                <div class="footer-col">
                    <h3 class="footer-title">Contacto</h3>
                    <ul class="footer-info">
                        <li class="footer-link">Adolfo Ruiz Cortinez No. 44, Veracruz, Ver.</li>
                        <li class="footer-link">info@gympower.com</li>
                        <li class="footer-link">(555) 123-4567</li>
                    </ul>
                </div>
            </div>
            <div class="footer-bottom">
                <p>&copy; <span id="currentYear"></span> GymPower. Todos los derechos reservados. Todos los datos aqui mostrados son ficticios</p>
            </div>
        </div>
    </footer>

    <script src="~/js/navbar.js" asp-append-version="true"></script>
    <script src="~/js/landing-animations.js" asp-append-version="true"></script>

    @RenderSection("Scripts", required: false)
</body>

</html>
