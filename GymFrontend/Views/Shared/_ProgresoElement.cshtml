@model DTO.Dtos.ProgresoElement;
@using DTO.Dtos;


@functions {
    public string getTipoDeBorde()
    {
        var tipoDeBorde = "";
        if (Model.tipoDeElemento == DTO.Enums.TipoDeElemento.Medida)
        {
            tipoDeBorde = "specialBorder-ultimoValor";
        }
        else if (Model.tipoDeElemento == DTO.Enums.TipoDeElemento.Meta)
        {
            tipoDeBorde = "specialBorder-meta";
        }
        return tipoDeBorde;
    }
    public bool isDetailButton()
    {
        return Model.tipoDeElemento == DTO.Enums.TipoDeElemento.Detalle;
    }
}

<div class="progreso-element-card">
    <div class="progreso-element-header">
        <h3 class="progreso-element-title">@Model.titulo</h3>
    </div>

    <div class="progreso-element-body">
        <div class="progreso-value-container @getTipoDeBorde()">
            @if (@Model.tipoDeElemento == DTO.Enums.TipoDeElemento.Medida
                        || @Model.tipoDeElemento == DTO.Enums.TipoDeElemento.Meta
                        || @Model.tipoDeElemento == DTO.Enums.TipoDeElemento.UnidadDeMedida)
            {
                <div class="value-display">
                    <span class="value-number">@Model.datoPrincipal</span>
                    @if (@Model.tipoDeElemento == DTO.Enums.TipoDeElemento.Medida
                                    || @Model.tipoDeElemento == DTO.Enums.TipoDeElemento.Meta)
                    {
                        <span class="value-unit">@Model.unidadDeMedida</span>
                    }
                </div>
            }
            else
            {
                <div class="icon-container">
                    <img id="@Model.idHtmlElement"
                         src="@Url.Content(Model.datoPrincipal)"
                         class="progreso-icon @(@isDetailButton() ? "details-button" : "") @Model.cssClasses"
                         alt="@Model.titulo" />
                </div>
            }
        </div>

        @if (@Model.tipoDeElemento == DTO.Enums.TipoDeElemento.Medida || @Model.tipoDeElemento == DTO.Enums.TipoDeElemento.Meta)
        {
            <div class="progreso-element-footer">
                <span class="timestamp-label">Registrado:</span>
                <span class="timestamp-value">@Model.datoSecundario</span>
            </div>
        }

        @if (@Model.tipoDeElemento == DTO.Enums.TipoDeElemento.Parametro)
        {

            <div class="progreso-element-footer-parameter">
                <span class="timestamp-value">@Model.datoSecundario</span>
            </div>

        }
        
    </div>
</div>
