@using Microsoft.Extensions.Options
@using DTO.Dtos
@inject IOptionsSnapshot<TestCredentialsForRealUsers> TestCredentials

@if (TestCredentials.Value.Entries.Count > 0)
{
    <div class="test-credentials">
        <p class="test-credentials-title">Usuarios de prueba</p>
        @foreach (var entrada in TestCredentials.Value.Entries)
        {
            <div class="test-credentials-section">
                <p class="test-credentials-section-title">@entrada.Title</p>
                <div class="test-credentials-field">
                    <span class="test-credentials-label">User:</span>
                    <code class="test-credentials-value">@entrada.Email</code>
                </div>
                <div class="test-credentials-field">
                    <span class="test-credentials-label">Password:</span>
                    <code class="test-credentials-value">@entrada.Password</code>
                </div>
            </div>
        }
    </div>
}
