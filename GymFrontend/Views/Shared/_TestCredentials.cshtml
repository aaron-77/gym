@using Microsoft.Extensions.Options
@using DTO.Dtos
@inject IOptionsSnapshot<TestCredentialsForRealUsers> TestCredentials

@if (TestCredentials.Value.Entries.Count > 0)
{
    <div class="test-credentials">
        <p class="test-credentials-title">Usuarios de prueba</p>
        <div class="test-credentials-actions">
            @foreach (var entrada in TestCredentials.Value.Entries)
            {
                bool esEmpleado = entrada.Title.Contains("Empleado", StringComparison.OrdinalIgnoreCase);
                string icono = esEmpleado ? Url.Content("~/img/useradmin.svg") : Url.Content("~/img/useremployee.svg");
                <button type="button"
                        class="test-credentials-btn"
                        data-demo-credentials="true"
                        data-email="@entrada.Email"
                        data-password="@entrada.Password">
                    <img class="test-credentials-btn-icon" src="@icono" alt="" aria-hidden="true" />
                    <span>@entrada.Title</span>
                </button>
            }
        </div>
    </div>
}
