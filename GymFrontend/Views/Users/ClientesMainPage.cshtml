@using DTO.Dtos;
@model IEnumerable<DTO.Dtos.DTOItemProgreso>;
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
Layout = "layoutSeccionClientes.cshtml";

    var listadoUsuarios = ViewBag.usuarios as List<ExistingUser>;
    if (listadoUsuarios == null)
    {
        listadoUsuarios = new List<ExistingUser>();
    }
}

<div id="containerSeccionProgreso">
    @foreach (var progresoItem in Model)
    {


        <div id="rowProgreso" class="row progress-row" data-fkCliente="@progresoItem.medida.fkUsuario" data-fkParametro="@progresoItem.medida.fkParametro" data-fkejercicio="@progresoItem.medida.fkEjercicio">
            @if (progresoItem.medida.fkEjercicio != null)
            {
                <div class="col">

                    @Html.Partial("_ProgresoElement.cshtml", new ProgresoElement
       {
           datoPrincipal = progresoItem.medida.urlIconoEjercicio,
           datoSecundario = progresoItem.medida.nombreEjercicio,
           titulo = "Ejercicio",
           unidadDeMedida = null,
           tipoDeElemento = DTO.Enums.TipoDeElemento.Ejercicio
       })

                </div>
            }

            <div class="col">
                @Html.Partial("_ProgresoElement.cshtml", new ProgresoElement
       {
           datoPrincipal = progresoItem.medida.urlIconoParametro,
           datoSecundario = progresoItem.medida.nombreParametro,
           titulo = "Parametro",
           unidadDeMedida = null,
           tipoDeElemento = DTO.Enums.TipoDeElemento.Parametro
       })


            </div>
            <div class="col">

                @Html.Partial("_ProgresoElement.cshtml", new ProgresoElement
       {
           datoPrincipal = progresoItem.medida.valor.ToString(),
           datoSecundario = progresoItem.medida.fechaDeCreacion.ToString(),
           titulo = "Ultimo Registro",
           unidadDeMedida = progresoItem.medida.nombreUnidadDeMedida,
           tipoDeElemento = DTO.Enums.TipoDeElemento.Medida
       })

            </div>
            <div class="col">
                @Html.Partial("_ProgresoElement.cshtml", new ProgresoElement
       {
           datoPrincipal = progresoItem.medida.valor.ToString(),
           datoSecundario = progresoItem.medida.fechaDeCreacion.ToString(),
           titulo = "Meta",
           unidadDeMedida = progresoItem.medida.nombreUnidadDeMedida,
           tipoDeElemento = DTO.Enums.TipoDeElemento.Meta
       })

            </div>
            <div class="col">

                @Html.Partial("_ProgresoElement.cshtml", new ProgresoElement
       {
           datoPrincipal = "/content/view-details-svgrepo-com.svg",
           datoSecundario = progresoItem.medida.fechaDeCreacion.ToString(),
           titulo = "Detalles",
           unidadDeMedida = null,
           tipoDeElemento = DTO.Enums.TipoDeElemento.Detalle,
           idHtmlElement = "detailsButton" + progresoItem.medida.medidaId
       })


            </div>
        </div>
    }

</div>

<script src="assets/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
<script src="assets/vendor/quill/quill.js"></script>
<script src="assets/vendor/tinymce/tinymce.min.js"></script>

<!-- Template Main JS File -->
<script src="~/js/main.js"></script>
<script src="~/js/empleados.js" asp-append-version="true"></script>
