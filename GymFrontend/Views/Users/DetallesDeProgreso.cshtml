
@{
    var anosActivo = ViewBag.anosActivo;
    var userId = ViewBag.userId;

    Layout = "layoutSeccionClientes";
}
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
<link href="~/css/styleSeccionGraficacion.css" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.js"
    integrity="sha512-ZwR1/gSZM3ai6vCdI+LVF1zSq/5HznD3ZSTk7kajkaj4D292NLuduDCO1c/NT8Id+jE58KYLKT7hXnbtryGmMg=="
    crossorigin="anonymous" referrerpolicy="no-referrer"></script>
<script src="./moment.min.js"></script>
<script type="module" src="/lib/annotationChartJs//chartjs-plugin-annotation.min.js"></script>
<script src="@Html.Raw("https://cdn.jsdelivr.net/npm/chartjs-adapter-moment@^1")"></script>



<div class="container add-flex-display">
    <div class="slideable-container">
        <div class="accordion" id="accordionExample">
            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button" type="button" data-bs-toggle="collapse"
                        data-bs-target="#collapseOne" aria-expanded="true" aria-controls="collapseOne">
                        Filtros de búsqueda
                    </button>
                </h2>
                <div id="collapseOne" class="accordion-collapse collapse show" data-bs-parent="#accordionExample">
                    <div class="accordion-body">
                        <div class="form-container">
                            <form id="chartForm" class="chart-form">
                                <div class="subSeccion">
                                    <div class="form-group ">
                                        <label for="inputEjercicio">Ejercicio</label>
                                        <select type="text" id="inputEjercicio" class="parametrosElement"
                                            name="idEjercicio">
                                        </select>
                                    </div>
                                    <div class="form-group">
                                        <label for="inputParametro">Parametro</label>
                                        <select id="inputParametro" class="parametrosElement" name="idParametro"
                                            required></select>
                                    </div>
                                </div>

                                <div class="subSeccion">
                                    <div class="form-group">
                                        <label for="espaciadoTemporal">Espaciado Temporal:</label>
                                        <select id="espaciadoTemporal" name="espaciadoTemporal" name="espaciadoTemporal"
                                            required disabled>
                                            <option value="">Selecciona una opción</option>
                                            <option value="individual">Individual</option>
                                            <option value="rango">Rango</option>
                                        </select>
                                    </div>

                                    <div class="form-group ">
                                        <label for="tipoDeBusqueda">Tipo de Búsqueda:</label>
                                        <select id="tipoDeBusqueda" class="custom-time-search-item"
                                            name="tipoDeBusqueda" required disabled>
                                            <option value="">Selecciona una opción</option>
                                            <option value="mes">Mes</option>
                                            <option value="año">Año</option>
                                        </select>
                                    </div>
                                </div>


                                <div class="form-group date-range">
                                    <div>
                                        <label for="fechaInicio">Fecha de Inicio:</label>
                                        <input type="date" id="fechaInicio" class="range-element" name="fechaInicio"
                                            disabled>
                                    </div>
                                    <div>
                                        <label for="fechaFin">Fecha Fin:</label>
                                        <input type="date" id="fechaFin" class="range-element" name="fechaFin" disabled>
                                    </div>
                                </div>

                                <div class="form-group months-container">
                                    <label>Meses:</label>
                                    <div class="months-grid">
                                        <div class="month-checkbox">
                                            <input type="checkbox" id="enero"
                                                class="month-checkbox-item custom-time-search-item" name="mesesDeFiltro"
                                                value="enero">
                                            <label for="enero">Enero</label>
                                        </div>
                                        <div class="month-checkbox">
                                            <input type="checkbox" id="febrero"
                                                class="month-checkbox-item custom-time-search-item" value="febrero"
                                                name="mesesDeFiltro">
                                            <label for="febrero">Febrero</label>
                                        </div>
                                        <div class="month-checkbox">
                                            <input type="checkbox" id="marzo"
                                                class="month-checkbox-item custom-time-search-item" value="marzo"
                                                name="mesesDeFiltro">
                                            <label for="marzo">Marzo</label>
                                        </div>
                                        <div class="month-checkbox">
                                            <input type="checkbox" id="abril"
                                                class="month-checkbox-item custom-time-search-item" name="mesesDeFiltro"
                                                value="abril">
                                            <label for="abril">Abril</label>
                                        </div>
                                        <div class="month-checkbox">
                                            <input type="checkbox" id="mayo"
                                                class="month-checkbox-item custom-time-search-item" name="mesesDeFiltro"
                                                value="mayo">
                                            <label for="mayo">Mayo</label>
                                        </div>
                                        <div class="month-checkbox">
                                            <input type="checkbox" id="junio"
                                                class="month-checkbox-item custom-time-search-item" name="mesesDeFiltro"
                                                value="junio">
                                            <label for="junio">Junio</label>
                                        </div>
                                        <div class="month-checkbox">
                                            <input type="checkbox" id="julio"
                                                class="month-checkbox-item custom-time-search-item" name="mesesDeFiltro"
                                                value="julio">
                                            <label for="julio">Julio</label>
                                        </div>
                                        <div class="month-checkbox">
                                            <input type="checkbox" id="agosto"
                                                class="month-checkbox-item custom-time-search-item" name="mesesDeFiltro"
                                                value="agosto">
                                            <label for="agosto">Agosto</label>
                                        </div>
                                        <div class="month-checkbox">
                                            <input type="checkbox" id="septiembre"
                                                class="month-checkbox-item custom-time-search-item" name="mesesDeFiltro"
                                                value="septiembre">
                                            <label for="septiembre">Septiembre</label>
                                        </div>
                                        <div class="month-checkbox">
                                            <input type="checkbox" id="octubre"
                                                class="month-checkbox-item custom-time-search-item" name="mesesDeFiltro"
                                                value="octubre">
                                            <label for="octubre">Octubre</label>
                                        </div>
                                        <div class="month-checkbox">
                                            <input type="checkbox" id="noviembre"
                                                class="month-checkbox-item custom-time-search-item" name="mesesDeFiltro"
                                                value="noviembre">
                                            <label for="noviembre">Noviembre</label>
                                        </div>
                                        <div class="month-checkbox">
                                            <input type="checkbox" id="diciembre"
                                                class="month-checkbox-item custom-time-search-item" name="mesesDeFiltro"
                                                value="diciembre">
                                            <label for="diciembre">Diciembre</label>
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group years-container">
                                    <label>Años:</label>
                                    <div class="years-grid">
                                        @foreach (var year in anosActivo)
                                        {
                                            <div class="year-checkbox">
                                                <input type="checkbox" id="year@(year)"
                                                    class="year-checkbox-item custom-time-search-item" name="añosDeFiltro"
                                                    value="@year">
                                                <label for="year@(year)">@year</label>
                                            </div>
                                        }
                                    </div>
                                </div>
                                <div class="submit-button-container d-flex justify-content-center">
                                    <input type="button" id="submitButton" class="btn btn-primary" name="meses"
                                        value="Consultar">
                                </div>

                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        @*  <button class="toggle-form-btn" onclick="toggleForm()">
                <i class="bi bi-chevron-bar-expand"></i>
            </button> *@
        @* <div class="form-slide" id="formSlide">

        </div> *@
    </div>

    <div class="chart-container">
        <div class="form-group checkbox-group conDetalleGroup">
            <input type="checkbox" id="conDetalle" name="conDetalle" form="chartForm">
            <label for="conDetalle">Mostrar todas las medidas</label>
        </div>
        <canvas id="myChart" class="canvas-chart"></canvas>
        <div id="errorMessageContainer" style="display: none;"
            class="d-flex justify-content-center align-items-center w-100"> No encontraron medidas con esos datos</div>
    </div>

</div>
<script type="module" src="~/js/observerPattern.js"></script>
<script type="module" src="~/js/seccionGraficacionControl.js"></script>
<script type="module" src="~/js/tester.js"></script>
