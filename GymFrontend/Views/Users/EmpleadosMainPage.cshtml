@using DTO.Dtos;
@model DTO.Dtos.DTOMedida;
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
Layout = "_LayoutSeccionAdministracion";

    var listadoUsuarios = ViewBag.usuarios as List<ExistingUser>;
    var listadoParametros = ViewBag.parametros as List<DTOParametroDeMedicion>;
    var listadoUnidadesDeMedida = ViewBag.unidades as List<DTOUnidadDeMedida>;
    if (listadoUsuarios == null)
    {
        listadoUsuarios = new List<ExistingUser>();
    }
}

<head>
    <link rel="stylesheet" href="/css/nuevosEstilos.css">
</head>
<div class="pagetitle">
    <h1>Medidas</h1>

</div><!-- End Page Title -->

<section class="section medidas-section">

    <form id="formCitaMedicion" class="formulario needs-validation novalidate" action="registrar" method="post">
        <div>
            <label for="inputPeso" class="form-label">Usuario</label>
            <select id="inputPeso" class="form-select empleados-main-page-input" name="fkUsuario" aria-label="Default select example" required>
                <option class="fix-fontColor-option" selected>selecciona un usuario </option>
                @foreach (var user in listadoUsuarios)
                {
                    <option value="@user.Id" class="fix-fontColor-option">@user.NombreCompleto @user.Apellido</option>
                }
            </select>
            <div class="invalid-feedback">Selecciona un usuario</div>
            <div class="valid-feedback"></div>
        </div>

        <div>
            <label for="inputParametro" class="form-label">Parametro</label>
            <select id="inputParametro" class="form-select empleados-main-page-input" name="fkParametro" aria-label="Default select example" required>
                <option class="fix-fontColor-option" selected>selecciona un parametro </option>
                @foreach (var parametro in listadoParametros)
                {
                    <option value="@parametro.parametroMedicionId" class="fix-fontColor-option">@parametro.nombre</option>
                }
            </select>
            <div class="invalid-feedback">Selecciona un parametro</div>
            <div class="valid-feedback"></div>
        </div>

        <div>
            <label for="inputUnidadDeMedida" class="form-label">Unidad de medida</label>
            <select id="inputUnidadDeMedida" class="form-select empleados-main-page-input" name="unidadDeMedidaId" aria-label="Unidad de medida" required>
                <option class="fix-fontColor-option" selected>Selecciona una Unidad de medida </option>
                @foreach (var unidadDeMedida in listadoUnidadesDeMedida)
                {
                    <option value="@unidadDeMedida.UnidadDeMedidaId" class="fix-fontColor-option">@unidadDeMedida.Nombre
                    </option>
                }
            </select>
            <div class="invalid-feedback">Selecciona una unidad de medida</div>
            <div class="valid-feedback"></div>
        </div>

        <div>
            <label for="inputValor" class="form-label">valor</label>
            <input id="inputValor" type="text" name="valor" step="0.01" class="form-control empleados-main-page-input" required>
            <div class="invalid-feedback">Ingresa un valor</div>
            <div class="valid-feedback"></div>
        </div>

        <button type="submit" class="btn btn-primary fix-margin">Submit</button>
    </form>
</section>

@section Scripts {
    
    <script type="module" src="~/js/messageManager.mjs"></script>
    <script type="module" src="~/js/registroMedidaLogic.mjs" asp-append-version="true"></script>
    
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js" integrity="sha384-ndDqU0Gzau9qJ1lfW4pNLlhNTkCfHzAVBReH9diLvGRem5+R9g2FzA8ZGN954O5Q" crossorigin="anonymous"></script>
}