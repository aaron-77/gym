@model DTO.Dtos.UserCredentials;

@{
    ViewData["Title"] = "GymPower - Iniciar Sesión";
    ViewData["Description"] = "Inicia sesión en GymPower y accede a tu cuenta para reservar clases y más.";
    ViewData["BodyClass"] = "login-page";
    Layout = "_NavbarLayout";
}

@section Styles {
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/login.css" type="text/css">
    <link rel="stylesheet" href="~/css/custom-navbar.css" type="text/css">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap">
}

<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml">
    <head>
        <title>@ViewData["Title"]</title>
    </head>
    <body class="@ViewData["BodyClass"]">
        <div class="main-container">
            <div class="form-container" id="loginform">
                <p class="title">Iniciar Sesión</p>
                
                <form class="form" method="post" action="signIn">
                    <span id="validationSumary" class="validation-error">@ViewBag.message</span>
                    <div class="input-group">
                        <label for="username">Email</label>
                        <input asp-for="@Model.correo" type="text" name="correo" id="username" placeholder="">
                        <span asp-validation-for="@Model.correo" class="validation-error"></span>
                    </div>
                    <div class="input-group">
                        <label for="password">Contraseña</label>
                        <input asp-for="@Model.contrasena" type="password" name="contrasena" id="password" placeholder="">
                        <span asp-validation-for="@Model.contrasena" class="validation-error"></span>
                        <div class="forgot">
                            <a rel="noopener noreferrer" href="#">Olvidaste tu contraseña ?</a>
                        </div>
                    </div>
                    <button class="sign">Inicar sesion</button>
                </form>
                <p class="signup">
                    ¿No tienes cuenta?
                    <a rel="noopener noreferrer" asp-area="" asp-controller="Users" asp-action="crearCuenta">Crear cuenta</a>
                </p>
            </div>
        </div>
    </body>
</html>

@section Scripts {
    
    <script>
        // Mobile menu toggle functionality
        document.addEventListener('DOMContentLoaded', function() {
            const mobileMenuBtn = document.getElementById('mobileMenuBtn');
            const navLinks = document.getElementById('navLinks');
            
            if (mobileMenuBtn && navLinks) {
                mobileMenuBtn.addEventListener('click', function() {
                    this.classList.toggle('active');
                    mobileMenuBtn.classList.toggle('active');
                });
            }
        });
    </script>
}
