@model DTO.Dtos.UserCredentials;

@{
    ViewData["Title"] = "FitnessGym - Iniciar Sesión";
    ViewData["Description"] = "Inicia sesión en FitnessGym y accede a tu cuenta para reservar clases y más.";
    ViewData["BodyClass"] = "login-page";
    Layout = "_NavbarLayout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/login.css" type="text/css">  
}

        <div class="main-container">
            <div class="form-container" id="loginform">
                <p class="title">Iniciar Sesión</p>
                <environment include="Production,Staging">
                <div class="test-credentials">
                    <p class="test-credentials-title">Usuarios de prueba</p>
                    <div class="test-credentials-section">
                        <p class="test-credentials-section-title">Empleado</p>
                        <div class="test-credentials-field">
                            <span class="test-credentials-label">User:</span>
                            <code class="test-credentials-value">uno@gmail.com</code>
                        </div>
                        <div class="test-credentials-field">
                            <span class="test-credentials-label">Password:</span>
                            <code class="test-credentials-value">Password123*</code>
                        </div>
                    </div>
                    <div class="test-credentials-section">
                        <p class="test-credentials-section-title">Cliente</p>
                        <div class="test-credentials-field">
                            <span class="test-credentials-label">User:</span>
                            <code class="test-credentials-value">litercatlitercat@gmail.com</code>
                        </div>
                        <div class="test-credentials-field">
                            <span class="test-credentials-label">Password:</span>
                            <code class="test-credentials-value">Password123*</code>
                        </div>
                    </div>
                </div>
                </environment>
                <form class="form" method="post" action="signIn">
                    <span id="validationSumary" class="validation-error">@ViewBag.message</span>
                    <div class="input-group">
                        <label for="username">Email</label>
                        <input asp-for="@Model.correo" type="text" name="correo" id="username" placeholder="">
                        <span asp-validation-for="@Model.correo" class="validation-error"></span>
                    </div>
                    <div class="input-group">
                        <label for="password">Contraseña</label>
                        <input asp-for="@Model.contrasena" type="password" name="contrasena" id="password" placeholder="">
                        <span asp-validation-for="@Model.contrasena" class="validation-error"></span>
                        <div class="forgot">
                            <a rel="noopener noreferrer" href="#">Olvidaste tu contraseña ?</a>
                        </div>
                    </div>
                    <button class="sign">Inicar sesion</button>
                </form>
                <p class="signup">
                    ¿No tienes cuenta?
                    <a rel="noopener noreferrer" asp-area="" asp-controller="Users" asp-action="CrearCuenta">Crear cuenta</a>
                </p>
            </div>
        </div>

@section Scripts {
    
}
